{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tg-toolbox-sync",
  "main": "src/index.mjs",
  "compatibility_date": "2026-05-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tg-toolbox-sync",
      "database_id": "REPLACE_AFTER_CREATING_D1",
      "migrations_dir": "migrations"
    }
  ]
}
