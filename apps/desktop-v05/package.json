    "@types/tabulator-tables": "^6.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
